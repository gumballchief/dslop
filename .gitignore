# Only the product goes public. Notes, films, research screenshots and key setup scripts stay local.
/*
!/.gitignore
!/README.md
!/TASTE.md
!/seldon.mjs
!/seldon.ps1
!/app

/app/.impeccable/
/app/.vercel/
/app/.next/
/app/node_modules/
/app/.env*
/app/*.tsbuildinfo

# the bench (code, site list, results; no screenshots of other people's sites)
!/research
/research/*
!/research/chrome.mjs
!/research/bench
/research/bench/*
!/research/bench/bench.mjs
!/research/bench/sites.json
!/research/bench/RESULTS.md
